    {
      "stage": "分析",
      "speech": "嗯……咱们先来琢磨琢磨这道题哈。题目说原有战士排成8列，那总人数肯定是个8的倍数，对吧？然后呢，加120人或者减120人，都能变成正方形方阵，也就是某一个数的平方，是不是这个理儿？",
      "board": {
        "content": "设总人数为 x\nx = 8的倍数\nx + 120 = a²\nx - 120 = b²",
        "startDelay": 1.5
      },
      "boards": [
        {
          "content": "设总人数为 x\nx = 8的倍数\nx + 120 = a²\nx - 120 = b²",
          "startDelay": 1.5
        }
      ],
      "actionSpec": [
        {
          "action": {
            "tool": "rough-line",
            "region": "analysis",
            "order": 4,
            "style": {
              "colorId": "red",
